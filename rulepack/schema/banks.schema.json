{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scamshield/rulepack/banks.schema.json",
  "title": "banks.json",
  "type": "object",
  "required": ["schema_version", "brands"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "_comment": { "type": "array", "items": { "type": "string" } },
    "brands": {
      "type": "array",
      "minItems": 120,
      "items": {
        "type": "object",
        "required": ["id", "display_name", "aliases", "domains", "dlt_headers"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "domains": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" }
          },
          "dlt_headers": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z0-9]{3,9}$" }
          }
        }
      }
    }
  }
}
